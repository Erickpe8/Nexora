{
  "version": 2,
  "installCommand": "npm run vercel-install",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "mobile/dist",
  "cleanUrls": true,
  "framework": null,
  "functions": {
    "api/index.ts": {
      "includeFiles": "backend/dist/**",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "handle": "filesystem" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/:path*", "destination": "/" }
  ]
}
