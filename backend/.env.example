# ============================================================
# Nexora Backend — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio.
# ============================================================

# --- Servidor ---
# Debe coincidir con EXPO_PUBLIC_API_URL en mobile/.env
# Ejemplo: http://192.168.x.x:4010/api  (IP LAN para Expo Go)
PUERTO=4010
NODE_ENV=development

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PUERTO=3306
DB_NOMBRE=nexora
DB_USUARIO=nexora_user
DB_CONTRASENA=nexora_pass

# --- JWT ---
# Cambia este valor en producción. Mínimo 32 caracteres aleatorios.
JWT_SECRETO=cambia_este_secreto_en_produccion
JWT_EXPIRACION=7d

# --- DeepSeek API ---
# Obtén tu clave en https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-e311c93a145b40fc9b78c63dbba74f75
DEEPSEEK_URL=https://api.deepseek.com/v1/chat/completions

# --- Endpoint interno (pipeline IA manual) ---
# Clave para POST /api/interno/ia/generar
# Cambia en producción o deshabilita la ruta completamente.
INTERNO_API_KEY=nexora_interno_dev

# --- Moderación ---
# IDs de usuarios con rol moderador, separados por coma. Ej: 1,2,5
# En desarrollo, si está vacío, todos los usuarios autenticados pueden moderar.
MODERADOR_IDS=

# Número de denuncias pendientes para auto-ocultar un comentario (0 = deshabilitado)
MODERACION_UMBRAL_DENUNCIAS=5

# Activar ocultamiento automático al superar el umbral (true/false)
MODERACION_AUTO_OCULTAR=false

# --- Cron externo (GitHub Actions / VPS / Railway) ---
# Secreto compartido: Authorization: Bearer <CRON_SECRET>
# Mínimo 16 caracteres. Generar: openssl rand -hex 32
CRON_SECRET=cambia_este_secreto_cron_minimo_32_chars

# Orígenes permitidos en header X-Cron-Origen (opcional, coma-separados)
CRON_ORIGENES_PERMITIDOS=github-actions,manual,render,railway,vps,local

# --- URLs públicas (compartir noticias) ---
# Origen web sin barra final, ej. https://nexora-ruddy-nine.vercel.app
PUBLIC_WEB_URL=http://localhost:8081
