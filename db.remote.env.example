# 1) Crea MySQL gratis en https://railway.app → New Project → Add MySQL
# 2) Abre el servicio MySQL → Connect → copia "MySQL Connection URL"
# 3) Copia este archivo a db.remote.env y pega UNA sola línea:
#
# MYSQL_URL=mysql://usuario:password@host.railway.app:3306/railway
#
# Si Railway pide SSL, añade también:
# DB_SSL=true
