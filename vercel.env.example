# Variables de entorno en el proyecto Vercel (Settings → Environment Variables).
# La app web usa EXPO_PUBLIC_* en tiempo de build; el API lee el resto en runtime.

# Si no la defines, el build usa https://VERCEL_URL/api (previews). En producción conviene la URL canónica:
# EXPO_PUBLIC_API_URL=https://tu-dominio.vercel.app/api

# Backend (mismo significado que backend/.env)
# DB_HOST=
# DB_PUERTO=3306
# DB_NOMBRE=nexora
# DB_USUARIO=
# DB_CONTRASENA=
# JWT_SECRETO=
# JWT_EXPIRACION=7d
# NODE_ENV=production
# DEEPSEEK_API_KEY=   # obligatorio para generar posts en Vercel
# CRON_SECRET=        # secreto para /api/cron/generar-ia (scripts y Bearer)
# INTERNO_API_KEY=    # alternativa en desarrollo (header X-Interno-Api-Key)
