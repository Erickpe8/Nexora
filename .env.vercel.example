# Copia a .env.vercel (raíz) y completa DB_* con tu MySQL en la nube.
# No uses localhost: Vercel no alcanza tu Docker local.
#
# Generar desde tus .env locales:
#   npm run vercel:prepare
#
# Subir a Vercel:
#   vercel link && npm run vercel:env

EXPO_PUBLIC_API_URL=https://nexora-ruddy-nine.vercel.app/api

DB_HOST=TU_HOST_MYSQL_REMOTO
DB_PUERTO=3306
DB_NOMBRE=nexora
DB_USUARIO=
DB_CONTRASENA=

JWT_SECRETO=
JWT_EXPIRACION=7d

DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com/v1/chat/completions

NODE_ENV=production
